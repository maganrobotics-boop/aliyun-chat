+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { registerHooks } from 'node:module';
+
+// Isolate the two unchanged shared dependencies. All payload checks and the
+// HMAC request handler below are the actual candidate bridge implementation.
+const errorModule = 'data:text/javascript,' + encodeURIComponent("export class PublicError extends Error { constructor(message,status=400){super(message);this.name='PublicError';this.status=status;} }");
+const windowsModule = 'data:text/javascript,' + encodeURIComponent("export const ACTIVITY_WINDOWS=Object.freeze({'24h':86400000,'3d':259200000,'7d':604800000});");
+const hooks = registerHooks({ resolve(specifier, context, nextResolve) {
+  if (specifier === './errors.mjs') return {url:errorModule,shortCircuit:true};
+  if (specifier === './activity-windows.mjs') return {url:windowsModule,shortCircuit:true};
+  return nextResolve(specifier,context);
+} });
+const { validStarsPayload, handleFutureStarsBridge, signFutureStarsRequest, FUTURE_STARS_PATH } = await import('../chat-cloudflare/src/future-stars-bridge.mjs');
+hooks.deregister();
+
+const actor = {email:'admin@example.com',subject:'verified-admin'};
+const directory = params => ({actor,operation:'platform_directory',params:{operation:'presence',window:'24h',...params}});
+
+test('directory presence accepts explicit IP, account and legacy default grouping', () => {
+  for (const window of ['24h','3d','7d']) {
+    for (const group of [{},{groupBy:'ip'},{groupBy:'account'}]) {
+      assert.equal(validStarsPayload(directory({window,page:'1',...group})),true);
+    }
+  }
+});
+
+test('directory grouping remains limited to presence and exact string values', () => {
+  const subject='12345678-1234-1234-1234-123456789abc';
+  for (const operation of ['activity','legacy_arena']) {
+    assert.equal(validStarsPayload(directory({operation,subject})),true);
+    for (const groupBy of ['ip','account']) assert.equal(validStarsPayload(directory({operation,subject,groupBy})),false);
+  }
+  for (const groupBy of ['','IP','accounts','all',null,true,1,{},[]]) assert.equal(validStarsPayload(directory({groupBy})),false);
+});
+
+test('directory grouping cannot bypass actor, outer-key or parameter validation', () => {
+  for (const forgedActor of [null,'admin',{}, {...actor,isAdmin:true}, {...actor,role:'admin'}, {...actor,email:'invalid'}, {...actor,subject:''}]) {
+    assert.equal(validStarsPayload({...directory({groupBy:'ip'}),actor:forgedActor}),false);
+  }
+  assert.equal(validStarsPayload({...directory({groupBy:'ip'}),isAdmin:true}),false);
+  assert.equal(validStarsPayload({...directory({groupBy:'ip'}),body:{}}),false);
+  for (const params of [{isAdmin:'1'}, {scope:'all'}, {window:'30d'}, {page:'0'}, {page:1}, {q:'x'.repeat(101)}, {section:'versions'}]) {
+    assert.equal(validStarsPayload(directory({groupBy:'ip',...params})),false);
+  }
+});
+
+test('existing people, arena, honors and write payload cases retain their validation', () => {
+  const cases = [
+    [{operation:'recipients',params:{q:'Alice'}},true],
+    [{operation:'people',params:{window:'24h',page:'1',sort:'recent'}},true],
+    [{operation:'people',params:{window:'7d',includeActivity:'1'}},true],
+    [{operation:'people',params:{includeActivity:'0'}},false],
+    [{operation:'people',params:{groupBy:'ip'}},false],
+    [{operation:'arena',params:{window:'3d',sort:'best',mapId:'mine-1',mode:'full'}},true],
+    [{operation:'arena',params:{sort:'fastest'}},false],
+    [{operation:'arena',params:{mapId:'../escape'}},false],
+    [{operation:'honors',params:{category:'course',status:'approved',page:'1'}},true],
+    [{operation:'records',params:{email:'member@example.com',courseId:'intro',page:'1'}},true],
+    [{operation:'events',params:{id:'event-1'}},true],
+    [{operation:'grant',params:{},body:{courseId:'intro'}},true],
+    [{operation:'grant',params:{}},false],
+    [{operation:'honor_action',params:{id:'honor-1'},body:{action:'approve'}},true],
+    [{operation:'honors',params:{},body:{}},false],
+    [{operation:'unknown',params:{}},false],
+  ];
+  for (const [payload,expected] of cases) assert.equal(validStarsPayload({actor,...payload}),expected,JSON.stringify(payload));
+  const presence={actor,operation:'platform_presence',params:{app:'course',name:'Member',onlineActive:true,clientIp:'203.0.113.5'}};
+  assert.equal(validStarsPayload(presence),true);
+  assert.equal(validStarsPayload({...presence,params:{...presence.params,groupBy:'ip'}}),false);
+  assert.equal(validStarsPayload({...presence,params:{...presence.params,onlineActive:'true'}}),false);
+});
+
+test('legacy arena constraints still reject actor-scoped widening and unknown fields', () => {
+  const subject='12345678-1234-1234-1234-123456789abc';
+  assert.equal(validStarsPayload(directory({operation:'legacy_arena',subject,section:'versions'})),true);
+  for (const params of [{subject:'not-a-resolved-id'}, {q:'someone'}, {section:'all'}, {unknown:'1'}]) {
+    assert.equal(validStarsPayload(directory({operation:'legacy_arena',subject,...params})),false);
+  }
+});
+
+test('HMAC authentication is still required and invalid grouping never reaches the engine', async () => {
+  const secret='bridge-unit-test-secret-not-production-123456789';
+  const now=Date.now(),url='https://chat.omindos.cn'+FUTURE_STARS_PATH;
+  let handled=0,claimed=0;
+  const engine={claimRequest:async()=>{claimed++;},handle:async payload=>{handled++;return Response.json({groupBy:payload.params.groupBy??'account'});}};
+  const invoke=async(payload,alterHeaders=()=>{})=>{
+    const raw=JSON.stringify(payload),headers=new Headers(await signFutureStarsRequest(raw,secret,{now}));
+    alterHeaders(headers);
+    return handleFutureStarsBridge({request:new Request(url,{method:'POST',headers,body:raw}),env:{PUBLIC_LAB_AI_SERVICE_TOKEN:secret}},engine,now);
+  };
+  assert.equal((await invoke(directory({groupBy:'ip'}))).status,200);
+  assert.equal((await invoke(directory({groupBy:'account'}))).status,200);
+  assert.equal((await invoke(directory({}))).status,200);
+  assert.equal(handled,3);assert.equal(claimed,3);
+  assert.equal((await invoke(directory({groupBy:'ip'}),headers=>headers.delete('authorization'))).status,401);
+  assert.equal((await invoke(directory({groupBy:'ip'}),headers=>headers.set('origin','https://omindos.cn'))).status,401);
+  assert.equal((await invoke(directory({groupBy:'ip'}),headers=>headers.set('cookie','fake=1'))).status,401);
+  assert.equal((await invoke(directory({operation:'activity',groupBy:'ip'}))).status,400);
+  assert.equal((await invoke({...directory({groupBy:'ip'}),actor:{...actor,isAdmin:true}})).status,400);
+  assert.equal(handled,3);assert.equal(claimed,3);
+});
