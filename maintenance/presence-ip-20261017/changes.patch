diff --git a/tests/platform-presence-ip.test.mjs b/tests/platform-presence-ip.test.mjs
new file mode 100644
--- /dev/null
+++ b/tests/platform-presence-ip.test.mjs
@@ -0,0 +1,171 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { DatabaseSync } from 'node:sqlite';
+import { registerHooks } from 'node:module';
+
+// The production geo database is not part of this isolated change. Stub only
+// that external lookup dependency; exercise the real directory/network modules.
+const geoModule = 'data:text/javascript,' + encodeURIComponent("export default {default:class {search(){return {country:'中国',province:'广东省'};}}};");
+const hooks = registerHooks({ resolve(specifier, context, nextResolve) {
+  if (specifier === './vendor/ip2region/dist/lib/index.js') return { url:geoModule,shortCircuit:true };
+  return nextResolve(specifier,context);
+} });
+const { createPlatformDirectory } = await import('../aliyun/platform-directory.mjs');
+const { ensureNetworkSchema, recordNetwork, recordOnline, readOnlineSeconds, requestClientIp } = await import('../aliyun/platform-presence-network.mjs');
+const { unionOnlineMilliseconds } = await import('../aliyun/platform-presence-ip.mjs');
+hooks.deregister();
+
+const NOW = Date.UTC(2026,9,17,8,25), DAY = 86_400_000;
+const ADMIN = { email:'admin@example.com',subject:'verified-admin' };
+function fixture(t) {
+  const db = new DatabaseSync(':memory:');
+  t.after(() => db.close());
+  db.exec(`CREATE TABLE platform_accounts(id TEXT PRIMARY KEY,kind TEXT NOT NULL,display_name TEXT,username TEXT,created_at INTEGER,last_seen_at INTEGER);
+    CREATE TABLE platform_presence(subject TEXT NOT NULL,app TEXT NOT NULL,last_seen_at INTEGER NOT NULL,PRIMARY KEY(subject,app));`);
+  const directory = createPlatformDirectory({db,clock:() => NOW});
+  function account(id,kind='guest',name=id) {
+    db.prepare('INSERT INTO platform_accounts VALUES(?,?,?,?,?,?)').run(id,kind,name,null,NOW-8*DAY,NOW);
+    db.prepare('INSERT INTO platform_presence VALUES(?,?,?)').run(id,'course',NOW);
+  }
+  function interval(subject,ip,start,end) {
+    db.prepare('INSERT INTO platform_presence_online VALUES(?,?,?,?,1)').run(subject,ip,start,end);
+  }
+  const query = (extra={}) => directory.query({operation:'presence',window:'24h',groupBy:'ip',...extra},ADMIN);
+  return {db,directory,account,interval,query};
+}
+
+test('1000 requests from one IP produce one visit without inventing heartbeat time',t => {
+  const {db,account,query} = fixture(t); account('guest-a');
+  for(let n=0;n<1000;n++) recordNetwork(db,'guest-a','203.0.113.7',NOW-60_000+n);
+  const result = query();
+  assert.deepEqual(result.summary,{total:1,onlineSeconds:0,unrecorded:1});
+  assert.equal(result.records[0].onlineSeconds,null);
+  assert.equal(result.records[0].subjectCount,1);
+  assert.match(result.records[0].id,/^ip_[a-f0-9]{64}$/);
+  assert.equal(result.records[0].country,'中国');
+});
+
+test('distinct IPs count independently and overlapping accounts share an interval union',t => {
+  const {db,account,interval,query} = fixture(t); account('a');account('b','registered');account('c');
+  for(const subject of ['a','b']) recordNetwork(db,subject,'203.0.113.7',NOW);
+  recordNetwork(db,'c','1.2.3.4',NOW);
+  interval('a','203.0.113.7',NOW-600_000,NOW-300_000);
+  interval('b','203.0.113.7',NOW-480_000,NOW-180_000);
+  interval('c','1.2.3.4',NOW-60_000,NOW);
+  const result = query();
+  assert.deepEqual(result.summary,{total:2,onlineSeconds:480,unrecorded:0});
+  assert.equal(result.records.find(row=>row.ip==='203.0.113.7').onlineSeconds,420);
+  assert.equal(result.records.find(row=>row.ip==='203.0.113.7').subjectCount,2);
+});
+
+test('account duration also unions nested and repeated intervals',t => {
+  const {db,account,interval} = fixture(t); account('a');
+  interval('a','1.2.3.4',NOW-600_000,NOW);
+  interval('a','1.2.3.4',NOW-540_000,NOW-480_000);
+  interval('a','1.2.3.4',NOW-420_000,NOW-300_000);
+  assert.equal(readOnlineSeconds(db,'a','1.2.3.4',NOW-DAY,NOW),600);
+  assert.equal(unionOnlineMilliseconds([{started_at:30,ended_at:50},{started_at:0,ended_at:100},{started_at:0,ended_at:100}]),100);
+});
+
+test('a gap above 90 seconds starts a separate observed interval',t => {
+  const {db,account,query} = fixture(t); account('a');recordNetwork(db,'a','1.2.3.4',NOW);
+  for(const stamp of [NOW-600_000,NOW-540_000,NOW-300_000,NOW-240_000]) assert.equal(recordOnline(db,'a','1.2.3.4',stamp),true);
+  assert.equal(db.prepare('SELECT COUNT(*) AS n FROM platform_presence_online').get().n,2);
+  assert.equal(query().records[0].onlineSeconds,120);
+});
+
+test('all 24h/3d/7d windows clip intervals and exclude evidence outside the window',t => {
+  for(const [window,days] of [['24h',1],['3d',3],['7d',7]]) {
+    const {db,account,interval,query} = fixture(t);account('a');account('old');
+    const cutoff=NOW-days*DAY;
+    interval('a','1.2.3.4',cutoff-60_000,cutoff+60_000);
+    interval('a','1.2.3.4',NOW-60_000,NOW+60_000);
+    recordNetwork(db,'old','9.8.7.6',cutoff-1);
+    const result=query({window});
+    assert.equal(result.summary.total,1);
+    assert.equal(result.records[0].onlineSeconds,120);
+    assert.equal(result.records[0].lastSeenAt,NOW);
+  }
+});
+
+test('IP changes retain sightings while the account network remains its latest IP',t => {
+  const {db,account,interval,query} = fixture(t);account('a');
+  recordNetwork(db,'a','1.2.3.4',NOW-600_000);
+  recordNetwork(db,'a','5.6.7.8',NOW);
+  interval('a','1.2.3.4',NOW-600_000,NOW-540_000);
+  ensureNetworkSchema(db); // Repeated initialization is idempotent.
+  assert.equal(db.prepare('SELECT ip FROM platform_presence_network WHERE subject=?').get('a').ip,'5.6.7.8');
+  assert.deepEqual(query().summary,{total:2,onlineSeconds:60,unrecorded:1});
+  assert.equal(db.prepare('SELECT COUNT(*) AS n FROM platform_presence_ip_seen').get().n,2);
+});
+
+test('schema backfill preserves only known latest IP and historical heartbeat evidence',t => {
+  const {db,account,interval,query} = fixture(t);account('a');
+  db.prepare('INSERT INTO platform_presence_network VALUES(?,?,?,?,?,?)').run('a','5.6.7.8',null,null,'unknown',NOW);
+  interval('a','1.2.3.4',NOW-600_000,NOW-540_000);
+  ensureNetworkSchema(db);
+  assert.deepEqual(query().summary,{total:2,onlineSeconds:60,unrecorded:1});
+  assert.equal(db.prepare('SELECT COUNT(*) AS n FROM platform_presence_ip_seen').get().n,1);
+});
+
+test('no heartbeat is null while an observed single heartbeat is zero seconds',t => {
+  const {db,account,query} = fixture(t);account('a');account('b');
+  recordNetwork(db,'a','1.2.3.4',NOW);recordNetwork(db,'b','5.6.7.8',NOW);
+  recordOnline(db,'b','5.6.7.8',NOW);
+  const result=query();
+  assert.equal(result.records.find(row=>row.ip==='1.2.3.4').onlineSeconds,null);
+  assert.equal(result.records.find(row=>row.ip==='5.6.7.8').onlineSeconds,0);
+  assert.equal(result.summary.unrecorded,1);
+});
+
+test('subject and guest filters never expand to another account sharing its IP',t => {
+  const {db,account,interval,query} = fixture(t);account('a','guest','GuestA');account('b','registered','MemberB');
+  for(const subject of ['a','b'])recordNetwork(db,subject,'1.2.3.4',NOW);
+  interval('a','1.2.3.4',NOW-60_000,NOW);
+  interval('b','1.2.3.4',NOW-600_000,NOW);
+  for(const extra of [{subject:'a'},{q:'GuestA'},{q:'全部游客活动'}]) {
+    const result=query(extra);assert.equal(result.summary.total,1);assert.equal(result.records[0].subjectCount,1);assert.equal(result.records[0].onlineSeconds,60);
+  }
+  for(const q of ['Nobody的记录','unmatched text'])assert.equal(query({q}).summary.total,0);
+});
+
+test('account view remains default and grouping validation rejects activity IP mode',t => {
+  const {db,directory,account} = fixture(t);account('a');account('b','registered');
+  for(const subject of ['a','b'])recordNetwork(db,subject,'1.2.3.4',NOW);
+  const result=directory.query({operation:'presence',window:'24h'},ADMIN);
+  assert.equal(result.summary.total,2);assert.equal(result.summary.guests,1);assert.equal(result.summary.registered,1);
+  assert.equal(result.groupBy,undefined);
+  assert.throws(()=>directory.query({operation:'activity',window:'24h',groupBy:'ip'},ADMIN),/groupBy/);
+  assert.throws(()=>directory.query({operation:'presence',window:'24h',groupBy:'invalid'},ADMIN),/groupBy/);
+});
+
+test('pagination operates on IPs and has deterministic ordering',t => {
+  const {db,account,query}=fixture(t);
+  for(let n=1;n<=21;n++){account('a'+n);recordNetwork(db,'a'+n,'1.2.3.'+n,NOW);}
