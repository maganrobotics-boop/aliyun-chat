+++ b/aliyun/platform-presence-ip.mjs
@@ -0,0 +1,78 @@
+import { createHash } from 'node:crypto';
+
+/** Elapsed milliseconds in the union of observed intervals, never their sum. */
+export function unionOnlineMilliseconds(rows) {
+  const intervals = rows
+    .filter(row => Number.isSafeInteger(row.started_at) && Number.isSafeInteger(row.ended_at) && row.ended_at >= row.started_at)
+    .map(row => [row.started_at, row.ended_at])
+    .sort((left, right) => left[0] - right[0] || left[1] - right[1]);
+  let total = 0, end = -1;
+  for (const [start, finish] of intervals) {
+    total += Math.max(0, finish - Math.max(start, end));
+    end = Math.max(end, finish);
+  }
+  return total;
+}
+
+/**
+ * Administrator-only IP projection of the same account scope as the directory.
+ * Sightings prove an IP was observed; heartbeat intervals alone prove duration.
+ * Never join another account merely because it shares an IP with this scope.
+ */
+export function readIpPresence({ db, cutoff, timestamp, page = 1, pageSize = 20, subject, kind, geoForIp = () => ({ country: null, province: null, status: 'unknown' }) }) {
+  const accountConditions = [], accountBindings = [];
+  if (subject) { accountConditions.push('id = ?'); accountBindings.push(subject); }
+  if (kind) { accountConditions.push('kind = ?'); accountBindings.push(kind); }
+  const accountsWhere = accountConditions.length ? 'WHERE ' + accountConditions.join(' AND ') : '';
+  const rows = db.prepare(`WITH eligible AS (
+      SELECT id FROM platform_accounts ${accountsWhere}
+    ), evidence AS (
+      SELECT s.subject,s.ip,s.last_seen_at FROM platform_presence_ip_seen s JOIN eligible a ON a.id=s.subject
+      WHERE s.last_seen_at>=? AND s.last_seen_at<=?
+      UNION ALL
+      SELECT o.subject,o.ip,MIN(o.ended_at,?) AS last_seen_at
+      FROM platform_presence_online o JOIN eligible a ON a.id=o.subject
+      WHERE o.ended_at>=? AND o.started_at<=?
+    ), ips AS (
+      SELECT ip,MAX(last_seen_at) AS last_seen_at,COUNT(DISTINCT subject) AS subject_count FROM evidence GROUP BY ip
+    ), clipped AS (
+      SELECT o.ip,MAX(o.started_at,?) AS started_at,MIN(o.ended_at,?) AS ended_at
+      FROM platform_presence_online o JOIN eligible a ON a.id=o.subject
+      WHERE o.ended_at>=? AND o.started_at<=? AND o.ended_at>=o.started_at
+    ), ordered AS (
+      SELECT ip,started_at,ended_at,
+        MAX(ended_at) OVER (PARTITION BY ip ORDER BY started_at,ended_at ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING) AS prior_end
+      FROM clipped
+    ), durations AS (
+      SELECT ip,COUNT(*) AS samples,
+        SUM(MAX(0,ended_at-MAX(started_at,COALESCE(prior_end,started_at)))) AS elapsed
+      FROM ordered GROUP BY ip
+    ), networks AS (
+      SELECT n.*,ROW_NUMBER() OVER (PARTITION BY n.ip ORDER BY n.collected_at DESC,n.subject) AS position
+      FROM platform_presence_network n JOIN eligible a ON a.id=n.subject
+      WHERE n.collected_at<=?
+    )
+    SELECT ips.ip,ips.last_seen_at,ips.subject_count,d.samples,d.elapsed,
+      n.country,n.province,n.status,n.collected_at
+    FROM ips LEFT JOIN durations d ON d.ip=ips.ip
+      LEFT JOIN networks n ON n.ip=ips.ip AND n.position=1
+    ORDER BY ips.last_seen_at DESC,ips.ip`).all(...accountBindings,
+      cutoff,timestamp,timestamp,cutoff,timestamp,cutoff,timestamp,cutoff,timestamp,timestamp);
+  const summary = { total: rows.length, onlineSeconds: 0, unrecorded: 0 };
+  for (const row of rows) {
+    if (row.samples == null) summary.unrecorded++;
+    else summary.onlineSeconds += Math.floor(row.elapsed / 1000);
+  }
+  const offset = (page - 1) * pageSize;
+  return {
+    summary,
+    records: rows.slice(offset, offset + pageSize).map(row => {
+      const geo = row.status ? row : geoForIp(row.ip);
+      return { id: 'ip_' + createHash('sha256').update(row.ip).digest('hex'), ip: row.ip,
+        country: geo.country ?? null, province: geo.province ?? null, status: geo.status || 'unknown',
+        collectedAt: row.collected_at ?? row.last_seen_at, lastSeenAt: row.last_seen_at,
+        subjectCount: row.subject_count, onlineSeconds: row.samples == null ? null : Math.floor(row.elapsed / 1000) };
+    }),
+    pagination: { page, hasMore: rows.length > offset + pageSize },
+  };
+}
